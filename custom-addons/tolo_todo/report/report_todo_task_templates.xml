<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_todo_task_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <h2 class="mb-4">Task Details: <span t-field="doc.name"/></h2>
                        
                        <div class="row mt-3 mb-4">
                            <div class="col-6">
                                <strong>Assignee:</strong> <span t-field="doc.assignee_id.name"/><br/>
                                <strong>Deadline:</strong> <span t-field="doc.date_deadline"/><br/>
                                <strong>Company:</strong> <span t-field="doc.company_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong> <span t-field="doc.state"/><br/>
                                <strong>Priority:</strong> <span t-field="doc.priority"/><br/>
                                <strong>Is Overdue:</strong> 
                                <span t-if="doc.is_overdue" class="text-danger font-weight-bold">Yes</span>
                                <span t-else="">No</span>
                            </div>
                        </div>

                        <div class="card mt-4">
                            <div class="card-header font-weight-bold">Description</div>
                            <div class="card-body">
                                <span t-field="doc.description"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>