<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tolo_todo_task_list" model="ir.ui.view">
        <field name="name">tolo.todo.task.list</field>
        <field name="model">tolo.todo.task</field>
        <field name="arch" type="xml">
            <list string="Todo Tasks">
                <field name="name"/>
                <field name="assignee_id"/>
                <field name="deadline"/>
                <field name="priority"/>
                <field name="state"/>
                
                <!-- TODO: add field is_overdue -->
            </list>
        </field>
    </record>

    <record id="view_tolo_todo_task_form" model="ir.ui.view">
        <field name="name">tolo.todo.task.form</field>
        <field name="model">tolo.todo.task</field>
        <field name="arch" type="xml">
            <form string="Todo Task">
              <header>
                
                <button name="action_start" string="Start Task" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            
               <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
            

    <!-- Cancel button: Managers can cancel draft & in_progress; Users only draft -->
               <button name="action_cancel" string="Cancel Task" type="object"
                invisible="state not in ('draft', 'in_progress')"
                groups="tolo_todo.group_tolo_todo_manager"/>
               <button name="action_cancel" string="Cancel Task" type="object"
                 invisible="state != 'draft'"
                groups="!tolo_todo.group_tolo_todo_manager"/>

               <button name="action_reset_draft" string="Reset to Draft" type="object"
                invisible="state != 'cancelled'"/>
               <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>

              </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="assignee_id"/>
                        <field name="deadline"/>
                        <field name="priority"/>
                        <field name="is_overdue"  readonly="1"/>
                        <field name="state"  string="State"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BROKEN on purpose: xpath targets a field that does not exist.
         Fix the xpath OR delete this whole record so the module installs. -->
    <record id="view_tolo_todo_task_list_inherit_broken" model="ir.ui.view">
        <field name="name">tolo.todo.task.list.inherit.broken</field>
        <field name="model">tolo.todo.task</field>
        <field name="inherit_id" ref="view_tolo_todo_task_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <field name="is_overdue"/>
            </xpath>
        </field>
    </record>

    <record id="action_tolo_todo_task" model="ir.actions.act_window">
        <field name="name">Todo Tasks</field>
        <field name="res_model">tolo.todo.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tolo_todo_root"
              name="Tolo Todo"
              sequence="100"/>

    <menuitem id="menu_tolo_todo_tasks"
              name="Tasks"
              parent="menu_tolo_todo_root"
              action="action_tolo_todo_task"
              sequence="10"/>
</odoo>
