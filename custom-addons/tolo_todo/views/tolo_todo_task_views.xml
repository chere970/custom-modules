<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tolo_todo_task_list" model="ir.ui.view">
        <field name="name">tolo.todo.task.list</field>
        <field name="model">tolo.todo.task</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'" decoration-warning="is_overdue  and state == 'in_progress'"
                  decoration-danger="is_overdue and state == 'draft'" string="Todo Tasks">
                  
                  
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="assignee_id" widget="many2one_avatar_user"/>
                <field name="deadline"/>
                <field name="is_overdue" column_invisible="True"/>
                
                <field name="state" widget="badge"
                       />
            </list>
        </field>
    </record>

    <record id="view_tolo_todo_task_form" model="ir.ui.view">
        <field name="name">tolo.todo.task.form</field>
        <field name="model">tolo.todo.task</field>
        <field name="arch" type="xml">
            <form string="Todo Task">
              <header>
                
                <button name="action_start" string="Start Task" type="object" class="oe_highlight" invisible="state != 'draft'"/>
            
               <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
            

                 <!-- Cancel button: Managers can cancel draft & in_progress; Users only draft -->
               <button name="action_cancel" string="Cancel Task" type="object"
                invisible="state not in ('draft', 'in_progress')"
                groups="tolo_todo.group_tolo_todo_manager"/>
               <button name="action_cancel" string="Cancel Task" type="object"
                 invisible="state != 'draft'"
                groups="!tolo_todo.group_tolo_todo_manager"/>

               <button name="action_reset_draft" string="Reset to Draft" type="object"
                invisible="state != 'cancelled'"/>
               <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>

              </header>
                <sheet>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Prepare monthly audit report"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assignee_id" widget="many2one_avatar_user"/>
                            <field name="partner_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="is_overdue" column_invisible="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add specific task notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- Partner Form View Extension: Todo Tasks Smart Button -->
    <record id="view_partner_form_inherit_tolo_todo" model="ir.ui.view">
        <field name="name">res.partner.form.tolo.todo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_todo_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks">
                    <field name="todo_task_count" widget="statinfo" string="Todo Tasks"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- BROKEN on purpose: xpath targets a field that does not exist.
         Fix the xpath OR delete this whole record so the module installs. -->
    


    <record id="action_tolo_todo_task" model="ir.actions.act_window">
        <field name="name">Todo Tasks</field>
        <field name="res_model">tolo.todo.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_tasks': 1, 'search_default_open_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task!
            </p>
        </field>
    </record>

    <!-- <menuitem id="menu_tolo_todo_root"
              name="Tolo Todo"
              sequence="100"/>

    <menuitem id="menu_tolo_todo_tasks"
              name="Tasks"
              parent="menu_tolo_todo_root"
              action="action_tolo_todo_task"
              sequence="10"/> -->
</odoo>
