<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category for UI placement -->
    <record id="module_category_productivity_tolo_todo" model="ir.module.category">
        <field name="name">Tolo Todo</field>
        <field name="sequence">25</field>
    </record>

    <!-- Odoo 19 starter code -->
    <record id="privilege_tolo_todo" model="res.groups.privilege">
        <field name="name">Tolo Todo</field>
        <field name="category_id" ref="module_category_productivity_tolo_todo"/>
    </record>

    <record id="group_tolo_todo_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_tolo_todo"/>
    </record>

    <record id="group_tolo_todo_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_tolo_todo"/>
        <field name="implied_ids" eval="[(4, ref('group_tolo_todo_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Requirement 5: User vs Manager Record Rules -->
    <record id="rule_tolo_todo_user" model="ir.rule">
        <field name="name">Todo Task: User (Assigned or Created)</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="groups" eval="[(4, ref('group_tolo_todo_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_tolo_todo_manager" model="ir.rule">
        <field name="name">Todo Task: Manager (All Tasks)</field>
        <field name="model_id" ref="model_todo_task"/>
        <field name="groups" eval="[(4, ref('group_tolo_todo_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>