<record id="estate_property_form_view" model="ir.ui.view">
    <field name="name">real.estate.view.form</field>
    <field name="model">real.estate</field>
    <field name="arch" type="xml">
        <form>

            <header>
                <!-- Action Buttons on the Left -->
                <button name="action_sold" 
                        string="Sold" 
                        type="object" 
                        class="btn-primary" 
                        invisible="state == 'sold'"/>

                <button name="action_cancel" 
                        string="Cancel" 
                        type="object" 
                        class="btn-secondary" 
                        invisible="state in ('sold', 'canceled')"/>

                <!-- Status Pipeline Widget on the Right -->
                <field name="state" 
                       widget="statusbar" 
                       statusbar_visible="new,received,accepted,sold"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <field name="image" widget="image" class="img-fluid mb-3"/>
                    <label for="name" string="Property Name"/>
                    <h1>
                        <field name="name" placeholder="e.g. Cozy Villa"/>
                    </h1>
                    
                </div>

                <!-- Notebook container for tabs -->
                <notebook>
                    <!-- First Page / Tab -->
                    <page string="Information">
                        <group>
                            <group>
                                <field name="property_type_id"/>
                                <field name="state"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="expected_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="selling_price"/>
                                <field name="email" widget="email"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                            </group>
                        </group>
                    </page>

                    <!-- Second Page / Tab -->
                    <page string="Contact &amp; Details">
                        <group>
                    
                            <field name="phone" widget="phone"/>
                            <field name="code"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="view_real_estate_kanban" model="ir.ui.view">
    <field name="name">real.estate.kanban</field>
    <field name="model">real.estate</field>
    <field name="arch" type="xml">
        <kanban default_group_by="state">
            <field name="name"/>
            <field name="expected_price"/>
            <field name="best_offer"/>
            <field name="state"/>
            <field name="currency_id"/>
            <templates>
                <!-- In Odoo 17+, use 'card' instead of 'kanban-box' -->
                <t t-name="card">
                    <div class="d-flex flex-column gap-1">
                        <strong class="fs-5">
                            <field name="name"/>
                        </strong>
                        <div class="text-muted small">
                            Expected: <field name="expected_price" widget="monetary"/>
                        </div>
                        <div t-if="record.best_offer.raw_value" class="text-muted small">
                            Best Offer: <field name="best_offer" widget="monetary"/>
                        </div>
                        <div class="mt-2">
                            <field name="state" widget="badge"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>



    

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">real.estate.view.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
        
            <list>
                <field name="name"   />
                <field name="date_availability" />
            </list>
        </field>


    </record>

    <record id="test_record" model="ir.actions.act_window">
        <field name="name">Test one </field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">kanban,list,form</field>

    </record>

    <odoo>
    <record id="estate_cancel_wizard_view_form" model="ir.ui.view">
        <field name="name">estate.cancel.wizard.form</field>
        <field name="model">estate.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Property">
                <sheet>
                    <group>
                        <field name="reason" placeholder="Why is this listing canceled?"/>
                    </group>
                </sheet>
                <!-- Wizard Footer: Action button and Cancel button -->
                <footer>
                    <button name="action_confirm_cancel" 
                            string="Confirm Cancellation" 
                            type="object" 
                            class="btn-danger"/>
                    <button string="Discard" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

